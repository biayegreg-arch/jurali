generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  // Every user has an email — even phone-only signups (Jurali Phase 6).
  // auth.ts's TokenPayload/Context require `email: string` (protected,
  // not modified for this), so phone signups get a synthetic
  // non-deliverable placeholder (`<phone>@phone.jurali.local`) instead of
  // making this column nullable. Never used to actually send mail.
  email             String    @unique
  // Nullable: OAuth-only users (e.g. signed up with Google) never set a
  // password. Email/password signup still requires it; the auth route
  // enforces presence at runtime.
  passwordHash      String?
  emailVerifiedAt   DateTime?
  tokenVersion      Int       @default(0)
  withdrawalPinHash String? // bcrypt hash of withdrawal PIN; null = no PIN set
  // Optional display name — populated from OAuth profile on first sign-in.
  // Email/password users can fill it later via /api/auth/me PATCH (future).
  name              String?
  // Optional avatar URL — populated from OAuth profile on first sign-in.
  avatarUrl         String?
  // Jurali Phase 6 — phone + password auth (see /api/auth/phone-signup).
  // Real E.164 phone, unique, null for email/OAuth-only accounts.
  phone             String?   @unique
  // Shop name collected at phone signup (Inscription.jsx); null for
  // email/OAuth accounts that never went through that flow.
  shopName          String?
  // Phone-signup accounts get a synthetic `email` (see comment above) and
  // never prove they own a real address — 2026-09-03 fix. This holds an
  // optional real email collected at signup, awaiting confirmation via a
  // VerificationCode(type: EMAIL_VERIFY). On success it REPLACES `email`
  // (which stops being synthetic) and this column is cleared back to null.
  // No @unique here: the swap into `email` is where the real uniqueness
  // constraint bites, so two people typing the same still-unverified
  // address just race for who confirms first.
  pendingEmail      String?
  // Shop address — Phase 9 desktop /settings (Parametres.jsx's "Profil &
  // Boutique"), editable via PATCH /api/auth/me. Optional, display-only
  // (no feature currently depends on it, unlike Client.address's "pour tes
  // notes" caption — this one is purely informational on the profile).
  address           String?
  // Phase 9 — global opt-in for the auto-reminder cron (Parametres.jsx's
  // "Rappels WhatsApp automatiques"). Defaults false: existing users never
  // consented to this, and the cron only takes effect for Premium accounts
  // anyway (mirrors Phase 8's manual-reminder gate). Sending is never
  // silent — this only creates an in-app Notification; the boutiquier
  // still taps to open the wa.me link (see auto-reminder.ts).
  autoReminderEnabled Boolean @default(false)
  // Phase 9 — global opt-in for the daily "clients overdue 14+ days" digest
  // cron (Parametres.jsx's "Notifications dettes en retard") — a distinct
  // toggle from autoReminderEnabled: this is a once-a-day per-USER summary
  // notification, not a per-client WhatsApp nudge. Same Premium gate as
  // the 7-day reminder (see overdue-alert.ts).
  overdueAlertsEnabled Boolean @default(false)
  // App-wide role. USER is the default; ADMIN unlocks /admin back-office;
  // SUPERADMIN can promote/demote other admins. Bootstrap an initial
  // SUPERADMIN via `pnpm db:make-superadmin <email>` (see scripts).
  role              String    @default("USER") // USER | ADMIN | SUPERADMIN
  // Account status. ACTIVE = login + refresh allowed; SUSPENDED and DELETED
  // both refuse with 403 (ACCOUNT_SUSPENDED / ACCOUNT_DELETED) — DELETED is
  // a soft delete (data retained, reversible), not a real
  // `prisma.user.delete()`. Mutated via /api/admin/users/[id]/status
  // (ADMIN can suspend; only SUPERADMIN can restore, delete, or undelete).
  status            String    @default("ACTIVE") // ACTIVE | SUSPENDED | DELETED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  verificationCodes VerificationCode[]
  uploads           FileUpload[]
  notifications     Notification[]
  notifPrefs        NotificationPreferences?
  orders            Order[]
  withdrawals       Withdrawal[]
  oauthAccounts     OAuthAccount[]
  adminActions      AdminAction[]
  clients           Client[]
  transactions      Transaction[]
  subscription      Subscription?
  subscriptionPayments SubscriptionPayment[]
  couponsCreated    Coupon[]

  // Multi-tenancy is opt-in per project: by default no resource is org-scoped.
  // Apps that need it (marketplace, B2B SaaS, classifieds) wire owner relations
  // on their domain models.
  ownedOrganizations Organization[]      @relation("OrgOwner")
  memberships        OrganizationMember[] @relation("OrgMembership")

  @@index([email])
  @@index([role])
  @@index([status])
}

// ───────────────────────────────────────────────────────────────────────
// Admin audit log — every back-office mutation is recorded here so we can
// answer "who did what when" during incidents / compliance reviews.
//
// `action` is a free-form dotted string the UI groups by (e.g.
// "withdrawal.cancel", "user.role_change", "order.refund").
// `targetType` + `targetId` reference the affected row when applicable.
// `metadata` carries the diff or extra context as JSON.
//
// Retention: not pruned automatically (compliance). If your jurisdiction
// requires deletion after N years, add a cron in backend/src/index.ts
// modeled on the WebhookLog purge.
// ───────────────────────────────────────────────────────────────────────
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ───────────────────────────────────────────────────────────────────────
// Multi-tenancy primitives — opt-in.
//
// Default project surface stays user-owned (`Order.userId`, `Withdrawal.userId`).
// Apps that need orgs add `organizationId String?` to their domain models
// case by case and use `requireOrgRole()` middleware to gate access.
//
// Slug must be unique app-wide (not just within an owner) so it can be
// used as a stable URL segment.
// ───────────────────────────────────────────────────────────────────────
model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  ownerId   String
  owner     User     @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   OrganizationMember[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// Role precedence: OWNER > ADMIN > MEMBER. The owner is also a member row
// (created in the same tx as the org) so list-my-orgs queries can join
// uniformly via memberships.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("OrgMembership", fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// OAuth identities — one User can have N linked providers (Google, GitHub, …).
// (provider, providerAccountId) is unique so the same Google account can't
// link twice. Email matching at sign-in is intentional: if a user signed up
// with email/password and later "Sign in with Google" using the same email,
// we link the Google account to the existing user instead of creating a
// duplicate (see backend/src/routes/oauth.ts).
// ───────────────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "github" | …
  providerAccountId String // sub from the OIDC ID token
  // Optional refresh token (encrypted at rest if you store one) — Google
  // only returns it on first consent with `access_type=offline`. Most
  // boilerplate flows don't need it; we keep the column for future use.
  refreshToken      String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([code, type])
}

// ───────────────────────────────────────────────────────────────────────
// File uploads — Cloudinary (column names kept from the R2 era; no migration needed)
// ───────────────────────────────────────────────────────────────────────
model FileUpload {
  id        String   @id @default(cuid())
  userId    String? // nullable — uploads can be anonymous if route allows
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  key       String   @unique // Cloudinary public_id (column name historical — was R2 object key)
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — durable email queue rows
// ───────────────────────────────────────────────────────────────────────
model EmailJob {
  id          String    @id @default(cuid())
  to          String
  subject     String
  html        String
  text        String?
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — notifications (at-most-once via dedupeKey)
// ───────────────────────────────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreferences {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON map of { eventType: { email: bool, inApp: bool } } — flexible without migrations.
  prefs     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// Outbox — durable side-effects (notifications, emails) emitted from
// inside transactions (e.g. webhook handlers, withdrawal flow). Side-effect
// rows are inserted in the same tx as the state change, then a worker
// drains them. Survives crashes the previous postCommit-callback pattern
// silently dropped.
//
// `kind` is a free-form string the dispatcher routes on
// (e.g. "notification.payment_received", "email.payment_confirmation").
// ───────────────────────────────────────────────────────────────────────
model OutboxEvent {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — webhook idempotency log
// ───────────────────────────────────────────────────────────────────────
model WebhookLog {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([externalId, eventType])
  @@index([provider, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 3 — payments (Order + Withdrawal)
//
// `amount` is stored in the smallest unit of `currency` (no decimals).
// For XOF (FCFA, Senegal) that's 1 = 1 FCFA. For USD adapt to cents
// at the call site — the schema is currency-agnostic.
// ───────────────────────────────────────────────────────────────────────
model Order {
  id              String    @id @default(cuid())
  userId          String? // nullable — guest checkout supported
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount          Int // gross amount, smallest unit
  currency        String    @default("XOF") // ISO 4217
  status          String    @default("PENDING") // PENDING | PAID | EXPIRED | FAILED | REFUNDED
  customerEmail   String?
  customerPhone   String?
  customerName    String?
  metadata        Json? // app-specific fields

  // Stripe-grade idempotency. Required header on POST /api/orders; replay
  // with same value returns the original Order row instead of double-charging.
  // Nullable so existing rows pre-migration don't break the @unique constraint.
  idempotencyKey  String?   @unique

  // Provider reference
  provider         String // e.g. "bictorys"
  providerChargeId String? @unique
  paymentUrl       String? // checkout/redirect URL returned by provider
  paymentMethod    String? // WAVE | ORANGE_MONEY | FREE_MONEY (set on PAID by webhook)

  // Optional commission (for marketplace-style apps)
  commissionAmount Int?
  netAmount        Int?

  // Lifecycle
  expiresAt DateTime // PENDING expiry; not cleared on PAID (history)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([provider, providerChargeId])
}

model Withdrawal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount      Int // requested amount, smallest unit
  currency    String   @default("XOF")
  status      String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  destination Json // { method: "WAVE" | "ORANGE_MONEY" | ..., phone: "+221...", accountName?: "..." }

  // Provider reference
  provider         String // e.g. "bictorys"
  providerPayoutId String? @unique
  failureReason    String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  completedAt DateTime?

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@index([provider, providerPayoutId])
}

// ───────────────────────────────────────────────────────────────────────
// Jurali domain — credit notebook. Single-tenant per PRD (one shopkeeper
// per account, no org scoping): every Client and Transaction is owned by
// exactly one User via `ownerId`.
//
// Balance = sum(DEBT.amountFcfa) - sum(PAYMENT.amountFcfa) for a client.
// Aging (">30 jours") is computed FIFO: payments clear the oldest debts
// first, so "oldest unpaid debt" walks the client's transaction history
// in chronological order rather than needing a running-balance column.
// See src/lib/server/jurali/balance.ts.
// ───────────────────────────────────────────────────────────────────────
model Client {
  id                 String        @id @default(cuid())
  ownerId            String
  owner              User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  firstName          String
  phone              String?
  // Phase 9 — optional contact details added for the desktop "Créer
  // client"/"Fiche client" screens (2026-08-26). Both nullable: every
  // existing client and the mobile create-on-the-fly flow never collect
  // them. `email` has no send-mail usage yet (unlike User.email) — purely
  // a display/future-invoicing field, per the Banani source's own caption.
  email              String?
  address            String?
  lastReminderSentAt DateTime?
  // Per-client overrides of the account-wide reminder settings
  // (User.autoReminderEnabled/overdueAlertsEnabled — still the master
  // Premium-gated switches). `autoReminderEnabled` defaults true so every
  // existing client keeps today's behavior; the two threshold columns are
  // nullable — null means "use the global constant"
  // (AUTO_REMINDER_THRESHOLD_DAYS / OVERDUE_ALERT_THRESHOLD_DAYS) — see
  // lib/server/jurali/auto-reminder.ts and overdue-alert.ts (2026-09-02).
  autoReminderEnabled       Boolean   @default(true)
  autoReminderThresholdDays Int?
  overdueAlertThresholdDays Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  transactions       Transaction[]

  @@index([ownerId])
  @@index([ownerId, firstName])
}

model Transaction {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type       String // DEBT | PAYMENT
  amountFcfa Int // integer FCFA, no decimals
  note       String?
  createdAt  DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([ownerId, createdAt])
}

// Jurali Phase 7 — Premium subscription (PRD §4/§6, US-06). Monthly-only
// V1 (Phase 0.3 decision): one row per user, reused across renewals rather
// than a row-per-billing-period ledger — "active" is always a live
// computation (`status === 'ACTIVE' && renewsAt > now`, see
// lib/server/jurali/subscription.ts), never trusted from `status` alone,
// so no expiration cron is needed to keep the free-tier gate correct.
// Field naming mirrors `Order` (providerChargeId/paymentUrl) since checkout
// reuses the same PaymentProvider.charge() flow.
model Subscription {
  id     String @id @default(cuid())
  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  status   String    @default("PENDING") // PENDING | ACTIVE | CANCELED | EXPIRED | FAILED
  renewsAt DateTime? // set to now()+30d when the webhook confirms payment

  planAmountFcfa Int @default(2500) // PRD §6 monthly price, snapshotted per checkout — already
  // net of any coupon discount applied at checkout time (see couponId below).

  // Coupon applied at the checkout that produced the CURRENT planAmountFcfa,
  // if any — set when the charge is initiated (POST /api/subscriptions),
  // NOT re-validated/reused on the next renewal (each checkout must supply
  // its own coupon code again). Coupon.redemptionCount is only incremented
  // once the webhook confirms this charge actually succeeded (onPaid),
  // never at checkout-initiation time, so an abandoned/failed checkout
  // doesn't burn a redemption.
  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  // Provider reference — same shape as Order, since checkout reuses
  // PaymentProvider.charge(). Unique per row: one in-flight/last checkout
  // at a time (this row is reused across renewals, not created fresh).
  provider         String? // e.g. "bictorys"
  providerChargeId String? @unique
  paymentUrl       String?

  // Last checkout attempt's chosen Mobile Money method/phone (Gestion
  // Premium's read-only "Moyen de paiement" card) — set in POST when the
  // charge is initiated, not confirmed by the webhook, same scoping as
  // `provider`/`paymentUrl` above (this row is reused across renewals).
  paymentMethod String? // "WAVE" | "ORANGE_MONEY" | "FREE_MONEY"
  paymentPhone  String? // E.164, e.g. "+221771234567"

  // Renewal-reminder cron (subscription-renewal-reminders) — since Mobile
  // Money has no auto-debit, renewal is always a manual re-checkout, so we
  // email a heads-up before `renewsAt` lapses. `reminderStage` tracks the
  // last stage sent ("3d" | "1d" | "expired"); `reminderStageRenewsAt` pins
  // it to the `renewsAt` value it was computed for, so a fresh billing
  // cycle (renewsAt changes on renewal) naturally resets the stage without
  // any explicit cleanup.
  reminderStage         String?
  reminderStageRenewsAt DateTime?

  payments SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// Append-only payment ledger for Premium subscription charges. Each
// webhook-confirmed event (paid/failed, refunds recorded as failed) gets
// its own permanent row — unlike Subscription.providerChargeId, which is
// overwritten on every renewal (this row is reused across billing cycles,
// see subscriptions/guards.ts). Without this table, the admin "Revenus"
// page could only correlate a subscriber's MOST RECENT checkout attempt
// (WebhookLog scan joined on the current providerChargeId); once they
// renewed, their earlier payments silently dropped out of the history.
// Written inside the same Serializable webhook tx as the Subscription
// update (see api/webhooks/bictorys/route.ts onPaid/onFailed/onRefunded).
model SubscriptionPayment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  status           String // "PAID" | "FAILED"
  amountFcfa       Int // snapshot of Subscription.planAmountFcfa at the time of this event
  providerChargeId String

  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([createdAt])
}

// Admin-editable platform settings. Single row (fixed id "singleton") —
// deliberately not a generic key-value store: today only the Premium price
// needs to be admin-editable, and a typed 1-column table is simpler than a
// KV schema for a single setting. `getPremiumMonthlyPriceFcfa` in
// subscriptions/guards.ts falls back to the hardcoded default when no row
// exists yet (no backfill migration needed).
model PlatformConfig {
  id                      String   @id @default("singleton")
  premiumMonthlyPriceFcfa Int      @default(2500)
  updatedAt               DateTime @updatedAt
}

// Premium checkout discount codes, SUPERADMIN-managed (/admin/coupons —
// same bar as changing PlatformConfig.premiumMonthlyPriceFcfa, since both
// affect what a customer is charged). No max-redemption cap by design
// (confirmed with the user) — an admin retires a coupon by flipping
// `active` to false or setting `expiresAt` in the past, not by exhausting
// a counter. `redemptionCount` is purely informational, incremented only
// when a checkout using this coupon is confirmed PAID by the webhook (see
// Subscription.couponId) — never at checkout-initiation time.
model Coupon {
  id         String  @id @default(cuid())
  code       String  @unique // stored uppercase; matched case-insensitively at validation time
  percentOff Int // 1-100
  active     Boolean @default(true)
  expiresAt  DateTime?

  redemptionCount Int @default(0)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}
